    <worksheet name='Order time and delay'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist' name='federated.1nsvupq0y4p82z188giq11es83so' />
          </datasources>
          <datasource-dependencies datasource='federated.1nsvupq0y4p82z188giq11es83so'>
            <column caption='Delay (days)' datatype='integer' name='[Calculation_3284271862231041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[estimated_delivery_date],[delivered_customer_date])' />
            </column>
            <column caption='Approved At' datatype='datetime' name='[approved_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3284271862231041]' derivation='Avg' name='[avg:Calculation_3284271862231041:qk]' pivot='key' type='quantitative' />
            <column caption='Delivered Customer Date' datatype='datetime' name='[delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Estimated Delivery Date' datatype='datetime' name='[estimated_delivery_date]' role='dimension' type='ordinal' />
            <column-instance column='[approved_at]' derivation='Month' name='[mn:approved_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3284271862231041]' derivation='None' name='[none:Calculation_3284271862231041:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column-instance column='[approved_at]' derivation='Quarter' name='[qr:approved_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[approved_at]' derivation='Year' name='[yr:approved_at:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nsvupq0y4p82z188giq11es83so].[none:order_status:nk]'>
            <groupfilter function='member' level='[none:order_status:nk]' member='&quot;delivered&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1nsvupq0y4p82z188giq11es83so].[none:order_status:nk]</column>
