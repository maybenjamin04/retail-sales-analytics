    <worksheet name='Sheet 7'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pie Chart of Late and Early deliveries</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist' name='federated.1nsvupq0y4p82z188giq11es83so' />
          </datasources>
          <datasource-dependencies datasource='federated.1nsvupq0y4p82z188giq11es83so'>
            <column caption='Delay (days)' datatype='integer' name='[Calculation_3284271862231041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[estimated_delivery_date],[delivered_customer_date])' />
            </column>
            <column caption='IF [Delay (days)] &lt;= 0 THEN &quot;Early&quot; ELSE &quot;LATE&quot; END' datatype='string' name='[Calculation_3495378139029507]' role='dimension' type='nominal' user:unnamed='Sheet 7'>
              <calculation class='tableau' formula='IF [Calculation_3284271862231041] &lt;= 0 THEN &quot;Early&quot; ELSE &quot;LATE&quot; END' />
            </column>
            <column caption='Delivered Customer Date' datatype='datetime' name='[delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Estimated Delivery Date' datatype='datetime' name='[estimated_delivery_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3495378139029507]' derivation='None' name='[none:Calculation_3495378139029507:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3284271862231041]' derivation='Count' name='[pcto:cnt:Calculation_3284271862231041:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <style>
              <style-rule element='mark'>
                <encoding attr='color' field='[none:Calculation_3495378139029507:nk]' type='palette'>
                  <map to='#59a14f'>
                    <bucket>&quot;Early&quot;</bucket>
                  </map>
                  <map to='#e15759'>
                    <bucket>&quot;LATE&quot;</bucket>
                  </map>
                </encoding>
              </style-rule>
            </style>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='legend-title-text'>
            <format attr='color' field='[federated.1nsvupq0y4p82z188giq11es83so].[none:Calculation_3495378139029507:nk]' value='Delivery&#10;'>
              <formatted-text>
                <run>Delivery&#10;</run>
              </formatted-text>
            </format>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Pie' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.1nsvupq0y4p82z188giq11es83so].[none:Calculation_3495378139029507:nk]' />
              <wedge-size column='[federated.1nsvupq0y4p82z188giq11es83so].[pcto:cnt:Calculation_3284271862231041:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='2' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{0D0A9147-4DDE-4902-AEC6-75C9EFCAF8CF}' />
