        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1nsvupq0y4p82z188giq11es83so].[none:Calculation_3284271862231041:qk]' scope='rows' value='Delay of orders (pos = late, neg = early)' />
